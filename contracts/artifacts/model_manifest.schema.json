{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/artifacts/model_manifest.schema.json",
  "title": "Model Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_type",
    "artifact_path",
    "schema_version",
    "feature_names",
    "cat_features",
    "train_window",
    "created_at_utc",
    "metrics"
  ],
  "properties": {
    "input_contract": {
      "type": "object",
      "required": [
        "odds_contract_version",
        "odds_feature_version",
        "feature_names",
        "training_odds_policy",
        "allowed_prediction_policies",
        "availability_basis",
        "source_revision"
      ],
      "additionalProperties": false,
      "properties": {
        "odds_contract_version": {
          "const": "1.0"
        },
        "odds_feature_version": {
          "const": "1.0"
        },
        "feature_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "training_odds_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "max_age_seconds",
            "as_of",
            "minutes_before_start",
            "require_availability"
          ],
          "properties": {
            "mode": {
              "const": "pre_start"
            },
            "max_age_seconds": {
              "type": "number",
              "minimum": 0
            },
            "as_of": {
              "type": "null"
            },
            "minutes_before_start": {
              "type": "integer",
              "minimum": 0
            },
            "require_availability": {
              "type": "boolean"
            }
          }
        },
        "allowed_prediction_policies": {
          "type": "array",
          "items": {
            "enum": [
              "latest_before",
              "pre_start"
            ]
          },
          "uniqueItems": true
        },
        "availability_basis": {
          "enum": [
            "publication_time",
            "availability_time",
            "mixed"
          ]
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "training_filters": {
          "type": "object"
        }
      }
    },
    "training_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "year",
          "reason",
          "rows"
        ],
        "additionalProperties": false,
        "properties": {
          "year": {
            "type": "integer"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "rows": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "model_type": {
      "type": "string",
      "enum": [
        "place",
        "place_platt",
        "win"
      ]
    },
    "artifact_path": {
      "type": "string",
      "pattern": "^(pipeline/artifacts/models|notebook/prd/outputs/artifacts)/.+\\.pkl$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "feature_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "cat_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "train_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train_year_start",
        "train_year_end",
        "test_year"
      ],
      "properties": {
        "train_year_start": {
          "type": "integer"
        },
        "train_year_end": {
          "type": "integer"
        },
        "test_year": {
          "type": "integer"
        }
      }
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "auc",
        "brier",
        "logloss"
      ],
      "properties": {
        "auc": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "brier": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "logloss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "source_table": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "git_commit": {
      "type": "string"
    }
  }
}
