# Copy this file to .env or .env.<env> and edit values for the local pipeline runtime.
# Example: cp .env.example .env
# Example: cp .env.example .env.dev && HARP_ENV=dev uv run python -m pipeline.jobs.run_train

# Pipeline runtime settings.
# OS environment variables win over .env values.
# Required. Set the SQLAlchemy PostgreSQL URL only in your local .env file.
HARP_DB_URL=

HARP_TRAINING_MART_TABLE=mart.m_train_race_horse_past5
HARP_PREDICTION_MART_TABLE=mart.m_train_race_horse_past5

HARP_FEATURE_SETS_PATH=pipeline/config/feature_registry.yml

HARP_MLFLOW_TRACKING_URI=file:./mlflow
HARP_MLFLOW_TRAIN_EXPERIMENT=training
HARP_MLFLOW_FEATURE_VALIDATION_EXPERIMENT=feature_validation
HARP_MLFLOW_FEATURE_SELECTION_EXPERIMENT=feature_selection

HARP_LOG_LEVEL=INFO

# Predict job defaults. CLI arguments override these values.
HARP_PREDICT_FUKUSHO_BANKROLL=100000.0
HARP_PREDICT_FUKUSHO_KELLY_FRACTION=0.1
HARP_PREDICT_FUKUSHO_KELLY_CAP=0.05

# dbt (optional)
DBT_TARGET=dev
HARP_DB_HOST=localhost
HARP_DB_PORT=5432
HARP_DB_USER=harp
HARP_DB_PASSWORD=
HARP_DB_NAME=harp
HARP_DB_SCHEMA=public

# Docker Compose / Superset (required only when those services are used)
SUPERSET_DB_PASSWORD=
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=
