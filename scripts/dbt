#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

if [ -n "${UV_BIN:-}" ]; then
  :
elif command -v uv >/dev/null 2>&1; then
  UV_BIN="$(command -v uv)"
elif [ -x "$HOME/.local/bin/uv" ]; then
  UV_BIN="$HOME/.local/bin/uv"
elif [ -x "/opt/homebrew/bin/uv" ]; then
  UV_BIN="/opt/homebrew/bin/uv"
else
  echo "uv not found. Set UV_BIN to the uv executable path." >&2
  exit 127
fi

# uv parses dotenv values without executing them as shell commands.
# Later env files override earlier ones; exported OS variables win over both.
set -- dbt "$@"
if [ -n "${HARP_ENV:-${APP_ENV:-}}" ]; then
  ENV_FILE="$ROOT_DIR/.env.${HARP_ENV:-$APP_ENV}"
  if [ -f "$ENV_FILE" ]; then
    set -- --env-file "$ENV_FILE" "$@"
  fi
fi
if [ -f "$ROOT_DIR/.env" ]; then
  set -- --env-file "$ROOT_DIR/.env" "$@"
fi

exec "$UV_BIN" tool run --isolated \
  --from dbt-core==1.10.0 \
  --with dbt-postgres==1.9.1 \
  "$@"
